# Mithra on the demo server. Copy to .env beside docker-compose.yml.
#
#   cp deploy/.env.production.example .env
#
# Everything here is read at `docker compose up`. The two marked BUILD-TIME are
# read when the image is built instead — changing them means a rebuild.

# --- what nginx talks to -----------------------------------------------------
# The address the API and console bind to on the host. nginx runs in a
# container, so 127.0.0.1 would be the nginx container itself; this has to be
# an address that container can reach. Use the host's own address, the same one
# the other products in this deployment are proxied to.
BIND_ADDR=185.53.142.74
API_PORT=8092
WEB_PORT=3092

# --- secrets and credentials -------------------------------------------------
# https://www.mapillary.com/dashboard/developers — needed for street panoramas.
# Satellite and tile detection work without it; a street survey does not.
MAPILLARY_TOKEN="MLY|xxxxxxxxxxxx|xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Change this. It is the database password for a database that holds the
# inventory, and the default is the word "mithra".
DB_PASSWORD=change-this-to-something-long
DB_USER=mithra
DB_NAME=mithra

# --- behind TLS --------------------------------------------------------------
# The session cookie is only returned over HTTPS. Leave this true unless the
# deployment genuinely serves plain HTTP — with it wrongly true, sign-in appears
# to succeed and the next request is unauthenticated.
SESSION_COOKIE_SECURE=true

# Empty because the console and the API answer on one hostname, so the browser
# never makes a cross-origin request. Only fill this in if you split them.
CORS_ORIGINS=

# BUILD-TIME. Empty means the console calls /api/... on whatever host served
# the page, which is what the nginx config above expects. Set it only if the
# API lives on a different hostname — and rebuild the web image afterwards.
PUBLIC_API_ORIGIN=
