# Copy to .env and fill in the token. Everything else has a working default.

# Required: imagery and street-level sign detections.
# https://www.mapillary.com/dashboard/developers
MAPILLARY_TOKEN="MLY|your|token"

# The console's port on the host. Change it if 3000 is taken on your machine.
WEB_PORT=3000
API_PORT=8020

# Where the browser calls the API. Next inlines this into the client bundle at
# BUILD time, so changing it means rebuilding the web image:
#   docker compose build web
NEXT_PUBLIC_API_URL=http://localhost:8020

# Database credentials. The defaults are fine for a single deployment; change
# them and the volume is initialised with them on first start.
POSTGRES_USER=mithra
POSTGRES_PASSWORD=mithra
POSTGRES_DB=mithra

# Promote a trained classifier by pointing at its weights. Unset serves the
# zero-shot model. See docs/model.md.
# MITHRA_PROBE_PATH=/app/models/probe.npz
